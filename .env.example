# CodeSnap runtime environment
# Copy this file to .env and replace the values below.

# GitHub configuration
GITHUB_TOKEN=
GITHUB_OWNER=mymlogicofficial-collab
GITHUB_REPO=code_snap

# Local runtime
API_PORT=3000
PROXY_PORT=3001
USE_PROXY_INTERNAL=true

# Optional: allow additional local access paths separated by commas
ALLOWED_PATHS=./,C:/mymlo/projects/design-studio,C:/mymlo/projects/code_snap

# Optional: use external model API instead of local Ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=
